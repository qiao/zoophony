{
  "name": "zoophony",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node tools/split-soundfont.ts && vite",
    "build": "node tools/split-soundfont.ts && vite build && node tools/licenses.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt 'src/**' 'tools/*.ts' package.json tsconfig.json vite.config.ts .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check 'src/**' 'tools/*.ts' package.json tsconfig.json vite.config.ts .oxlintrc.json .oxfmtrc.json",
    "size": "node tools/size.ts"
  },
  "dependencies": {
    "spessasynth_core": "4.3.22"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "overrides": {
      "spessasynth_core": "4.3.22",
      "stb-vorbis": "0.0.6"
    }
  }
}
