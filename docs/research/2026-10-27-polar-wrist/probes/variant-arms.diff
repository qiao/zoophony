+def project_wrists(mesh, source):
+    from mathutils.bvhtree import BVHTree
+    deps = bpy.context.evaluated_depsgraph_get()
+    tree = BVHTree.FromObject(source, deps)
+    loops = set(WRIST_CODES)
+    tubes = {PART['tube'], PART['tube'] + 10}
+    bpy.context.view_layer.objects.active = mesh
+    bpy.ops.object.mode_set(mode='EDIT')
+    bm = bmesh.from_edit_mesh(mesh.data)
+    part = bm.verts.layers.int['arm_part']
+    verts = [p for p in bm.verts if p[part] in loops or (
+        p[part] in tubes and any(e.other_vert(p)[part] in loops for e in p.link_edges))]
+    most = 0.0
+    for p in verts:
+        hit = tree.find_nearest(p.co)
+        if hit[0] is not None:
+            most = max(most, (hit[0] - p.co).length)
+            p.co = p.co.lerp(hit[0], VAR["PROJECT"])
+    bmesh.update_edit_mesh(mesh.data)
+    bpy.ops.object.mode_set(mode='OBJECT')
+    print('PROJECT', len(verts), most)
 
 
+def smooth_wrist(bm, part):
+    loops = set(WRIST_CODES)
+    tubes = {PART['tube'], PART['tube'] + 10}
+    verts = [p for p in bm.verts if p[part] in loops or (
+        p[part] in tubes and any(e.other_vert(p)[part] in loops for e in p.link_edges))]
+    for _ in range(int(VAR['SMOOTH'])):
+        bmesh.ops.smooth_vert(bm, verts=verts, factor=VAR['FACTOR'], use_axis_x=True,
+                              use_axis_y=True, use_axis_z=True)
+    return len(verts)
+
