+def dome_cap(verts, faces, arm, heads, side, rule):
+    """Gives the cap of the arm of a cut a round inner side (`dome` of the cut). The flat cap
+    closes the inner side of the arm from the armpit across the elbow, and the bent elbow shows it
+    as a flat sheet with a straight edge (`docs/research/2026-10-21-rabbit-elbow.md`). Each edge
+    between two faces of the cap splits at its middle. The new vertex moves along the normal of
+    the cap, away from the free arm, by the share `share` of half the width of the edge across the
+    bone: the share 1 gives a half circle over the edge. Gives the new points, the two vertices of
+    the edge of each point, and the faces of the cap."""
+    s, e, w = (np.asarray(heads[f'{bone}_{side}'], float)
+               for bone in ('upper_arm', 'forearm', 'hand'))
+    upper = unit(e - s)
+    fore = unit(w - e)
+    middle = verts[arm].mean(axis=0)
+    count = {}
+    for f in faces:
+        for i in range(3):
+            key = (min(f[i], f[(i + 1) % 3]), max(f[i], f[(i + 1) % 3]))
+            count[key] = count.get(key, 0) + 1
+    faces = [list(f) for f in faces]
+    points, parents = [], []
+    for a, b in sorted(k for k, n in count.items() if n == 2):
+        m = 0.5 * (verts[a] + verts[b])
+        axis = fore if (m - e) @ (upper + fore) > 0 else upper
+        span = verts[b] - verts[a]
+        half = 0.5 * np.linalg.norm(span - (span @ axis) * axis)
+        both = [f for f in faces if a in f and b in f]
+        every = np.vstack([verts] + points) if points else verts
+        normal = sum(np.cross(every[f[1]] - every[f[0]], every[f[2]] - every[f[0]]) for f in both)
+        if np.linalg.norm(normal) < 1e-12:
+            continue
+        normal = unit(normal)
+        # The normal points away from the free arm: the cap closes its inner side.
+        near = verts[arm][np.abs((verts[arm] - m) @ axis) < rule['slab']]
+        inside = near.mean(axis=0) if len(near) else middle
+        if normal @ (m - inside) < 0:
+            normal = -normal
+        k = len(verts) + len(points)
+        points.append(m + rule['share'] * half * normal)
+        parents.append((a, b))
+        for f in both:
+            i = next(i for i in range(3) if {f[i], f[(i + 1) % 3]} == {a, b})
+            x, y, z = f[i], f[(i + 1) % 3], f[(i + 2) % 3]
+            faces.remove(f)
+            faces += [[x, k, z], [k, y, z]]
+    return points, parents, faces
+
