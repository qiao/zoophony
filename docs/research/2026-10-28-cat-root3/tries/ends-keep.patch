+def step_round_ends(s):
+    """Rounds the skin near the ends of each armpit line (`ends`).
+
+    The line lies on the plane of the seam, but `step_round_wall()` sinks the side wall and the
+    trunk near it into the trunk, and the front of the root, the socket and the first shoulder
+    ring, stays near the plane. At each end of the line, the skin thus made a small fin with
+    edges of 90 to 178 degrees, which showed as a point from az 150 and az -150, and as a notch
+    at the front of the arm root at rest (user, 2026-10-27: "the cat's arm has lumps"). Each
+    vertex within `reach` units of an end moves toward the middle of its neighbors (Smooth
+    Vertices), `rounds` times, with the factor 0.5 times a share that falls from 1 at the end to
+    0 at `reach` units. The tube from its first ring of Blender weights (`seam.ruled`) keeps its
+    place, so the arm keeps its round and its bone heat. Gives for each side the count of the
+    moved vertices and the largest move in units."""
+    rule = s.spec.get('ends')
+    if rule is None:
+        return None
+    mesh = s.mesh
+    bpy.context.view_layer.objects.active = mesh
+    bpy.ops.object.mode_set(mode='EDIT')
+    bm = bmesh.from_edit_mesh(mesh.data)
+    part = bm.verts.layers.int['arm_part']
+    index = bm.verts.layers.int['arm_ring']
+    reach = s.units(rule['reach'])
+    out = {}
+    for side, off in ((1, 0), (-1, 10)):
+        line = sorted((p for p in bm.verts if p[part] == PART['armpit'] + off),
+                      key=lambda p: p.co.y)
+        share = {}
+        for end in (line[0], line[-1]):
+            for p in bm.verts:
+                d = (p.co - end.co).length
+                if d < reach and p[part] != 0 and not (p[part] == PART['tube'] + off
+                                                       and p[index] >= s.spec['seam']['ruled']):
+                    share[p] = max(share.get(p, 0.0), 1.0 - d / reach)
+        start = {p: p.co.copy() for p in share}
+        for _ in range(rule['rounds']):
+            new = {}
+            for p, w in share.items():
+                ring = [x.other_vert(p).co for x in p.link_edges]
+                new[p] = p.co.lerp(sum(ring, Vector()) / len(ring), 0.5 * w)
+            for p, co in new.items():
+                move = co - start[p]
+                p.co = start[p] + move * min(1.0, s.units(rule['most']) / max(move.length, 1e-12))
+        out['LR'[off // 10]] = (len(share), round(max((p.co - start[p]).length for p in share)
+                                                  / s.fr.height, 5))
+    bmesh.update_edit_mesh(mesh.data)
+    bpy.ops.object.mode_set(mode='OBJECT')
+    return out
+
