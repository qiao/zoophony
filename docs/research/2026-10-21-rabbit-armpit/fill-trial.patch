+def fill_seam(verts, tris, seam_cut, rules, heads, ends, rule):
+    """Fills the bite that the cut leaves in the side of the trunk (`cut.fill` of the config). The
+    side of the trunk of the source curls in where it joins the hanging arm, so the cap of the body
+    lies in a notch, and a raised arm shows it as a missing piece. Each vertex of the run of the
+    body of a cut and `rings` rings of its neighbors outside the free arm move `share` of the way
+    to the middle of their neighbors outside the free arm, in `rounds` rounds. The vertices of the
+    free arm keep their places. Gives the moved vertices, the number of the moved vertices, and
+    the largest move."""
+    neighbors = [set() for _ in range(len(verts))]
+    for a, b, c in tris:
+        neighbors[a].update((b, c))
+        neighbors[b].update((a, c))
+        neighbors[c].update((a, b))
+    arm = np.zeros(len(verts), bool)
+    for sign in (1.0, -1.0):
+        arm |= free_arm(verts, tris, rules, heads, ends, sign)
+    region = set()
+    for _side, _removed, _faces, _arm_run, body_run in seam_cut:
+        ring = set(int(v) for v in body_run)
+        region |= ring
+        for _ in range(rule['rings']):
+            ring = {n for v in ring for n in neighbors[v] if not arm[n]} - region
+            region |= ring
+    ids = np.array(sorted(region))
+    around = [np.array(sorted(n for n in neighbors[v] if not arm[n])) for v in ids]
+    out = verts.copy()
+    for _ in range(rule['rounds']):
+        mids = np.array([out[n].mean(axis=0) for n in around])
+        out[ids] = out[ids] + rule['share'] * (mids - out[ids])
+    return out, len(ids), float(np.linalg.norm(out - verts, axis=1).max())
