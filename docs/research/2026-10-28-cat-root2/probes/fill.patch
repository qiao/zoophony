+    for f, (a, b, c) in enumerate(tris):
+        for u, v, w in ((a, b, c), (b, c, a), (c, a, b)):
+            edges.setdefault((min(u, v), max(u, v)), []).append((f, w))
+    out = np.zeros(len(points))
+    for (u, v), faces in edges.items():
+        if len(faces) != 2:
+            continue
+        (f0, _), (f1, far) = faces
+        if (points[far] - (points[u] + points[v]) / 2) @ normals[f0] <= 0:
+            continue
