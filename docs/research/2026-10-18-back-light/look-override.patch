+// LOOKLAB-TEMP: dev-only overrides of the look values from the query `look` (JSON of path → value).
+// Round back-light: BACK_ROW_LIGHT and LIGHT_POOL.reachBack. An angle is in radians.
+import { Color } from 'three';
+
+import { SCENE_COLORS } from './models/colors.ts';
+import { STAGE_COLORS } from './models/props.ts';
+import { FREE_BEAM_FADE, SHOT_BEAM_OPACITY } from './shots/beam-opacity.ts';
+import { BEAM_LOOK } from './scene/beam.ts';
+import { CAPTURE, ENVIRONMENT } from './scene/environment.ts';
+import { GRADE } from './scene/grade.ts';
+import { LIGHT_POOL } from './scene/light-pool.ts';
+import { BACK_ROW_LIGHT, CONDUCTOR_LIGHT, FILL, KEY_LIGHT, SIDE_LIGHT } from './scene/lights.ts';
+import { POST_LOOK, ROOM_HAZE } from './scene/post.ts';
+import { TIER_SETTINGS } from './scene/quality.ts';
+import { STAGE_FINISH, STAGE_SHADOW } from './scene/stage.ts';
+import { StageScene } from './scene/stage-scene.ts';
+import type { SoloFlag } from './scene/stage-scene.ts';
+
+const ROOTS: Record<string, unknown> = {
+  SCENE_COLORS,
+  STAGE_COLORS,
+  FREE_BEAM_FADE,
+  SHOT_BEAM_OPACITY,
+  BEAM_LOOK,
+  CAPTURE,
+  ENVIRONMENT,
+  GRADE,
+  LIGHT_POOL,
+  BACK_ROW_LIGHT,
+  CONDUCTOR_LIGHT,
+  FILL,
+  KEY_LIGHT,
+  SIDE_LIGHT,
+  POST_LOOK,
+  ROOM_HAZE,
+  TIER_SETTINGS,
+  STAGE_FINISH,
+  STAGE_SHADOW,
+};
+
+const text = new URLSearchParams(location.search).get('look');
+if (import.meta.env.DEV && text) {
+  const changes = JSON.parse(text) as Record<string, unknown>;
+  for (const [path, value] of Object.entries(changes)) {
+    const keys = path.split('.');
+    let node = ROOTS as Record<string, unknown>;
+    for (const key of keys.slice(0, -1)) {
+      node = node[key] as Record<string, unknown>;
+    }
+    const last = keys.at(-1) ?? '';
+    const old = node[last];
+    let next = value;
+    if (Array.isArray(old) && old.length === 3 && typeof value === 'string') {
+      const c = new Color(value);
+      next = [c.r, c.g, c.b];
+    }
+    node[last] = next;
+    console.log(`look override ${path} = ${JSON.stringify(next)}`);
+  }
+}
+
+// LOOKLAB-TEMP: the query `solo=<seat index>` solos one seat in the scene (round back-light).
+const soloText = new URLSearchParams(location.search).get('solo');
+if (import.meta.env.DEV && soloText !== null) {
+  const seat = Number(soloText);
+  const solo = StageScene.prototype.solo;
+  const forced = new WeakMap<readonly SoloFlag[], SoloFlag[]>();
+  StageScene.prototype.solo = function (this: StageScene, flags: readonly SoloFlag[]): void {
+    let next = forced.get(flags);
+    if (!next) {
+      // The app starts with no flags, so the list grows to the soloed seat.
+      const count = Math.max(flags.length, seat + 1);
+      next = Array.from({ length: count }, (_, i) => ({ ...flags[i], soloed: i === seat }));
+      forced.set(flags, next);
+    }
+    solo.call(this, next);
+  };
+  console.log(`look override solo ${seat}`);
+}
