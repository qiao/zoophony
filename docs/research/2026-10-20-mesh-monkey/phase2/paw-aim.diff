+/**
+ * Turns the module scratch `hand` of a paw on its grip from the line from its shoulder toward the
+ * line from the grip to the mouthpiece ({@link WindHold.handAim}). It reads the module scratch
+ * `shoulder` and `pivot`.
+ *
+ * @param gripAt The posed grip of the palm.
+ * @param share The share of the turn: 0 keeps the paw on the line from its shoulder.
+ */
+function aimPaw(gripAt: Vector3, share: number): void {
+  if (share <= 0) {
+    return;
+  }
+  aimLine.subVectors(shoulder.position, gripAt).normalize();
+  aimTo.subVectors(pivot, gripAt).normalize();
+  aimTo.lerp(aimLine, 1 - share).normalize();
+  hand.premultiply(aimTurn.setFromUnitVectors(aimLine, aimTo));
+}
