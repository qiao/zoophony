+def open_gap(verts, tris, heads, ends, split, rule):
+    """Opens a gap between each forearm and the belly (`gap` of the config). Each vertex of the
+    free arm (`free_arm()`) below the elbow joint that shares an edge with a vertex outside the
+    free arm moves the distance `distance` (units) away from the mean of those neighbors. Where
+    the hanging forearm of the source touches the belly, the mesh joins the two with short faces,
+    and their corners on the belly are also the top corners of the long faces of the side of the
+    trunk. The user permitted this move for the panda on 2026-10-18. Gives the vertices, the
+    indices of the moved vertices, and the faces whose shape changes."""
+    neighbors = [set() for _ in range(len(verts))]
+    for a, b, c in tris:
+        neighbors[a].update((b, c))
+        neighbors[b].update((a, c))
+        neighbors[c].update((a, b))
+    out = verts.copy()
+    moved = []
+    for side, sign in (('L', 1.0), ('R', -1.0)):
+        free = free_arm(verts, tris, split, mirrored(ends['fingers_L']) if side == 'R'
+                        else ends['fingers_L'], sign)
+        elbow = heads[f'forearm_{side}'][1]
+        for v in np.nonzero(free & (verts[:, 1] < elbow))[0]:
+            others = [n for n in neighbors[v] if not free[n]]
+            if others:
+                out[v] = verts[v] + rule['distance'] * unit(verts[v] - verts[others].mean(axis=0))
+                moved.append(int(v))
+    moved = np.array(moved, int)
+    faces = np.nonzero(np.isin(tris, moved).any(axis=1))[0]
+    return out, moved, faces
+
